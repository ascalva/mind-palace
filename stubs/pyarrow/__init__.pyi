"""Local type stubs: the slice of pyarrow this repository calls.

pyarrow 26.0.0, the first release with CPython 3.15 wheels (2026-10-29), ships no `py.typed`;
24.0.0 did. These stubs keep every pyarrow call site type-checked with no ignore comment and no
extra package. mypy reports any pyarrow name the code uses that is not declared here, so a new call
means a new line in this file, never a silent `Any`.
"""

from collections.abc import Iterable

class DataType: ...

class Schema:
    @property
    def names(self) -> list[str]: ...

class Table:
    def to_pylist(self) -> list[dict[str, object]]: ...

def string() -> DataType: ...
def int32() -> DataType: ...
def float32() -> DataType: ...
def bool_() -> DataType: ...
def list_(value_type: DataType, list_size: int = ...) -> DataType: ...
def schema(fields: Iterable[tuple[str, DataType]]) -> Schema: ...
